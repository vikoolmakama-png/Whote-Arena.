@app.route("/admin")
def admin_dashboard():
    if session.get("admin_logged_in") != True:
        return redirect(url_for("admin_login"))

    conn = get_db()

    total_users = conn.execute(
        "SELECT COUNT(*) FROM users"
    ).fetchone()[0]

    total_deposits = conn.execute(
        "SELECT COALESCE(SUM(amount), 0) FROM deposits WHERE status = 'approved'"
    ).fetchone()[0]

    total_withdrawals = conn.execute(
        "SELECT COALESCE(SUM(amount), 0) FROM withdrawals WHERE status = 'approved'"
    ).fetchone()[0]

    deposits = conn.execute("""
        SELECT deposits.id, deposits.amount, deposits.sender_name,
               deposits.status, deposits.rejection_reason,
               deposits.created_at, users.username
        FROM deposits
        JOIN users ON users.id = deposits.user_id
        ORDER BY deposits.id DESC
        LIMIT 50
    """).fetchall()

    withdrawals = conn.execute("""
        SELECT withdrawals.id, withdrawals.amount, withdrawals.status,
               withdrawals.bank_name, withdrawals.account_name,
               withdrawals.account_number, withdrawals.rejection_reason,
               withdrawals.created_at, users.username
        FROM withdrawals
        JOIN users ON users.id = withdrawals.user_id
        ORDER BY withdrawals.id DESC
        LIMIT 50
    """).fetchall()

    conn.close()

    return render_template(
        "admin/dashboard.html",
        total_users=total_users,
        total_deposits=total_deposits,
        total_withdrawals=total_withdrawals,
        deposits=deposits,
        withdrawals=withdrawals
    )


@app.route("/admin/login", methods=["GET", "POST"])
def admin_login():
    if request.method == "POST":
        username = request.form.get("username", "")
        password = request.form.get("password", "")

        if username == ADMIN_USERNAME and password == ADMIN_PASSWORD:
            session["admin_logged_in"] = True
            return redirect(url_for("admin_dashboard"))

        return render_template(
            "admin/login.html",
            error="Invalid admin username or password."
        )

    return render_template("admin/login.html")


@app.route("/admin/logout")
def admin_logout():
    session.pop("admin_logged_in", None)
    return redirect(url_for("admin_login"))

@app.route("/logout")
def logout():
    session.clear()
    return redirect(url_for("home"))



def create_next_tournament():
    from datetime import datetime, timedelta
    from zoneinfo import ZoneInfo

    nigeria = ZoneInfo("Africa/Lagos")
    now = datetime.now(nigeria).replace(tzinfo=None)

    conn = get_db()

    existing = conn.execute("""
        SELECT id
        FROM tournaments
        WHERE status = 'open'
        ORDER BY start_at ASC
        LIMIT 1
    """).fetchone()

    if existing:
        conn.close()
        return

    latest = conn.execute("""
        SELECT start_at
        FROM tournaments
        ORDER BY start_at DESC
        LIMIT 1
    """).fetchone()

    if latest:
        try:
            latest_start = datetime.fromisoformat(latest["start_at"])
            start_at = latest_start + timedelta(hours=2)

            if start_at <= now:
                start_at = now + timedelta(hours=2)
        except ValueError:
            start_at = now + timedelta(hours=2)
    else:
        start_at = now + timedelta(hours=2)

    conn.execute("""
        INSERT INTO tournaments
            (entry_fee, prize, max_players, min_humans, status, start_at)
        VALUES (200, 1700, 10, 4, 'open', ?)
    """, (start_at.isoformat(sep=" "),))

    conn.commit()
    conn.close()


def start_due_tournament():
    from datetime import datetime
    from zoneinfo import ZoneInfo

    nigeria = ZoneInfo("Africa/Lagos")
    now = datetime.now(nigeria).replace(tzinfo=None)

    conn = get_db()

    tournament = conn.execute("""
        SELECT id, entry_fee, prize, max_players, min_humans, start_at
        FROM tournaments
        WHERE status = 'open'
        ORDER BY start_at ASC, id ASC
        LIMIT 1
    """).fetchone()

    if not tournament:
        conn.close()
        return

    try:
        start_at = datetime.fromisoformat(tournament["start_at"])
    except ValueError:
        conn.close()
        return

    if start_at > now:
        conn.close()
        return

    tournament_id = tournament["id"]

    humans = conn.execute("""
        SELECT id, user_id, username, slot_number
        FROM tournament_players
        WHERE tournament_id = ?
          AND is_ai = 0
        ORDER BY slot_number ASC
    """, (tournament_id,)).fetchall()

    human_count = len(humans)
    min_humans = int(tournament["min_humans"])
    max_players = int(tournament["max_players"])

    if human_count < min_humans:
        for player in humans:
            conn.execute("""
                UPDATE users
                SET balance = balance + ?
                WHERE id = ?
            """, (tournament["entry_fee"], player["user_id"]))

        conn.execute("""
            UPDATE tournaments
            SET status = 'cancelled', completed_at = CURRENT_TIMESTAMP
            WHERE id = ?
        """, (tournament_id,))

        conn.commit()
        conn.close()
        return

    existing_ai = conn.execute("""
        SELECT COUNT(*)
        FROM tournament_players
        WHERE tournament_id = ?
          AND is_ai = 1
    """, (tournament_id,)).fetchone()[0]

    ai_needed = max_players - human_count - existing_ai

    ai_names = [
        "Arena AI 1",
        "Arena AI 2",
        "Arena AI 3",
        "Arena AI 4",
        "Arena AI 5",
        "Arena AI 6",
        "Arena AI 7",
        "Arena AI 8",
        "Arena AI 9",
        "Arena AI 10"
    ]

    used_slots = {
        row[0]
        for row in conn.execute("""
            SELECT slot_number
            FROM tournament_players
            WHERE tournament_id = ?
        """, (tournament_id,)).fetchall()
    }

    used_ai_names = {
        row[0]
        for row in conn.execute("""
            SELECT username
            FROM tournament_players
            WHERE tournament_id = ?
              AND is_ai = 1
        """, (tournament_id,)).fetchall()
    }

    for name in ai_names:
        if ai_needed <= 0:
            break

        if name in used_ai_names:
            continue

        slot = next(
            slot
            for slot in range(1, max_players + 1)
            if slot not in used_slots
        )

        conn.execute("""
            INSERT INTO tournament_players
                (tournament_id, user_id, username, is_ai, slot_number, status)
            VALUES (?, NULL, ?, 1, ?, 'active')
        """, (tournament_id, name, slot))

        used_slots.add(slot)
        ai_needed -= 1

    conn.execute("""
        UPDATE tournaments
        SET status = 'running', started_at = CURRENT_TIMESTAMP
        WHERE id = ?
          AND status = 'open'
    """, (tournament_id,))

    conn.commit()
    conn.close()


def tournament_scheduler():
    import time

    while True:
        try:
            create_next_tournament()
            start_due_tournament()
        except Exception:
            pass

        time.sleep(20)


def start_tournament_scheduler():
    import threading
    import os

    if os.environ.get("WERKZEUG_RUN_MAIN") not in (None, "true"):
        return

    if getattr(app, "_tournament_scheduler_started", False):
        return

    app._tournament_scheduler_started = True

    thread = threading.Thread(
        target=tournament_scheduler,
        daemon=True
    )
    thread.start()


init_db()
start_tournament_scheduler()


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
