<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>WHOT Arena — Game Table</title>
<style>
*{box-sizing:border-box}
body{
    margin:0;background:#050817;color:#fff;font-family:Arial,sans-serif;
    min-height:100vh;overflow-x:hidden
}
.top{
    display:flex;justify-content:space-between;align-items:center;
    padding:14px 16px;background:#0b1230;border-bottom:1px solid #202b58
}
.logo{font-weight:900;letter-spacing:1px;color:#55d9ff}
.logo span{color:#ff4d67}
.exit{color:#aab8d8;text-decoration:none;font-size:12px}
.game{max-width:650px;margin:auto;padding:12px}
.info{
    display:flex;justify-content:space-between;align-items:center;
    background:#0d1534;border:1px solid #26335f;border-radius:14px;padding:10px 13px
}
.info small{color:#8090b5;font-size:9px;display:block}
.info strong{font-size:14px}
.table{
    margin-top:10px;padding:14px;border-radius:22px;
    background:radial-gradient(circle at center,#123c43,#071a25 55%,#06101c);
    border:2px solid #263d62;min-height:610px;
    box-shadow:0 15px 50px rgba(0,0,0,.4)
}
.opponent{text-align:center}
.name{font-size:11px;color:#9cafcf;font-weight:800}
.hand-count{margin-top:5px;color:#ffcb55;font-size:11px}
.center{
    display:flex;justify-content:center;align-items:center;
    gap:18px;margin:25px 0
}
.card{
    width:76px;height:105px;border-radius:11px;background:#f8f8f8;
    color:#111;display:flex;flex-direction:column;justify-content:space-between;
    padding:8px;font-weight:900;box-shadow:0 7px 15px rgba(0,0,0,.35);
    border:3px solid #e8bd45
}
.card .symbol{font-size:30px;text-align:center;margin:auto}
.card.back{
    background:linear-gradient(135deg,#151e4c,#722a83);
    color:#fff;border-color:#55d9ff
}
.discard-label{font-size:8px;color:#7890ad}
.player-area{margin-top:20px}
.turn{
    text-align:center;color:#55d9ff;font-weight:900;font-size:13px;
    min-height:20px;margin-bottom:9px
}
.hand{
    display:flex;gap:7px;overflow-x:auto;padding:8px 2px 12px;
    scrollbar-width:none
}
.hand::-webkit-scrollbar{display:none}
.hand .card{flex:0 0 67px;width:67px;height:94px;cursor:pointer}
.hand .card:hover{transform:translateY(-5px)}
.card.invalid{opacity:.45;cursor:not-allowed}
.card.selected{transform:translateY(-8px);border-color:#ff4d67}
.controls{display:flex;gap:8px;margin-top:8px}
button{
    flex:1;border:0;border-radius:11px;padding:12px;font-weight:900;
    cursor:pointer;color:#fff;background:#25345f
}
button.primary{background:linear-gradient(135deg,#6845ff,#c42dff)}
button.red{background:linear-gradient(135deg,#e52d58,#ff6138)}
button:disabled{opacity:.4;cursor:not-allowed}
.message{
    margin-top:10px;text-align:center;color:#9cafcf;font-size:10px;
    min-height:16px
}
.rules{
    margin-top:12px;padding:10px;border-radius:12px;background:#090f27;
    color:#7487ad;font-size:9px;line-height:1.5;text-align:center
}
.modal{
    position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;
    align-items:center;justify-content:center;padding:20px;z-index:5
}
.modal.show{display:flex}
.modal-box{
    width:min(360px,100%);background:#0d1534;border:1px solid #33416e;
    border-radius:18px;padding:20px;text-align:center
}
.modal-box h2{margin:0 0 8px;color:#55d9ff}
.modal-box p{color:#9cafcf;font-size:12px}
@media(max-width:420px){
    .table{min-height:570px;padding:10px}
    .center{margin:18px 0}
    .card{width:70px;height:98px}
}
</style>
</head>
<body>

<header class="top">
    <div class="logo">WHOT <span>ARENA</span></div>
    <a href="/dashboard" class="exit">EXIT GAME</a>
</header>

<main class="game">
    <div class="info">
        <div>
            <small>PLAYER</small>
            <strong>{{ user['username'] }}</strong>
        </div>
        <div style="text-align:center">
            <small>STAKE</small>
            <strong>₦{{ "{:,}".format(stake) }}</strong>
        </div>
        <div style="text-align:right">
            <small>MODE</small>
            <strong>NORMAL</strong>
        </div>
    </div>

    <section class="table">
        <div class="opponent">
            <div class="name">ARENA OPPONENT</div>
            <div class="hand-count" id="opponentCount">5 CARDS</div>
        </div>

        <div class="center">
            <div class="card back">
                <span>WHOT</span>
                <div class="symbol">★</div>
                <span>ARENA</span>
            </div>

            <div>
                <div class="discard-label">TOP CARD</div>
                <div class="card" id="topCard">
                    <div id="topNumber">1</div>
                    <div class="symbol" id="topSymbol">●</div>
                    <div id="topSuit">CIRCLE</div>
                </div>
            </div>
        </div>

        <div class="player-area">
            <div class="turn" id="turnText">YOUR TURN</div>
            <div class="hand" id="playerHand"></div>

            <div class="controls">
                <button id="drawBtn" class="primary" onclick="drawCard()">DRAW CARD</button>
                <button id="whotBtn" class="red" onclick="callWhot()" disabled>CALL WHOT</button>
            </div>

            <div class="message" id="message">Play a card matching the number or symbol.</div>
        </div>

        <div class="rules">
            Match the <b>number</b> or <b>symbol</b> of the top card.
            A WHOT card can be played at any time. First player with no cards wins.
        </div>
    </section>
</main>

<div class="modal" id="resultModal">
    <div class="modal-box">
        <h2 id="resultTitle">GAME OVER</h2>
        <p id="resultText"></p>
        <button class="primary" onclick="location.href='/dashboard'">BACK TO DASHBOARD</button>
    </div>
</div>

<script>
const symbols = [
    {name:"CIRCLE", icon:"●"},
    {name:"TRIANGLE", icon:"▲"},
    {name:"SQUARE", icon:"■"},
    {name:"STAR", icon:"★"},
    {name:"CROSS", icon:"✚"}
];

let deck = [];
let playerHand = [];
let opponentHand = [];
let topCard = null;
let playerTurn = true;
let gameOver = false;

function buildDeck(){
    deck=[];
    for(let n=1;n<=14;n++){
        for(let s of symbols){
            deck.push({number:n,suit:s.name,icon:s.icon});
        }
    }
    for(let i=0;i<5;i++){
        deck.push({number:20,suit:"WHOT",icon:"★"});
    }
    deck.sort(()=>Math.random()-0.5);
}

function drawFromDeck(){
    if(deck.length===0) return null;
    return deck.pop();
}

function deal(){
    buildDeck();
    playerHand=[];
    opponentHand=[];
    for(let i=0;i<5;i++){
        playerHand.push(drawFromDeck());
        opponentHand.push(drawFromDeck());
    }
    topCard=drawFromDeck();
    if(topCard.number===20) topCard=drawFromDeck();
    render();
}

function canPlay(card){
    return card.number===20 ||
           card.number===topCard.number ||
           card.suit===topCard.suit;
}

function cardHTML(card, index){
    const invalid=!canPlay(card);
    return `
    <div class="card ${invalid?'invalid':''}"
         onclick="${invalid?'':'playCard('+index+')'}">
        <div>${card.number===20?'WHOT':card.number}</div>
        <div class="symbol">${card.icon}</div>
        <div>${card.suit}</div>
    </div>`;
}

function render(){
    document.getElementById("topNumber").textContent =
        topCard.number===20 ? "WHOT" : topCard.number;
    document.getElementById("topSymbol").textContent=topCard.icon;
    document.getElementById("topSuit").textContent=topCard.suit;

    document.getElementById("playerHand").innerHTML =
        playerHand.map((c,i)=>cardHTML(c,i)).join("");

    document.getElementById("opponentCount").textContent =
        opponentHand.length+" CARDS";

    document.getElementById("whotBtn").disabled =
        !playerHand.some(c=>c.number===20);

    document.getElementById("turnText").textContent =
        playerTurn ? "YOUR TURN" : "OPPONENT TURN";
}

function playCard(index){
    if(gameOver || !playerTurn) return;

    const card=playerHand[index];
    if(!canPlay(card)) return;

    playerHand.splice(index,1);
    topCard=card;

    if(playerHand.length===0){
        endGame(true);
        return;
    }

    playerTurn=false;
    document.getElementById("message").textContent="Opponent is thinking...";
    render();

    setTimeout(opponentMove,700);
}

function drawCard(){
    if(gameOver || !playerTurn) return;

    const card=drawFromDeck();
    if(!card){
        document.getElementById("message").textContent="No more cards in the deck.";
        return;
    }

    playerHand.push(card);
    document.getElementById("message").textContent="You drew a card.";
    render();
}

function opponentMove(){
    if(gameOver) return;

    let index=opponentHand.findIndex(canPlay);
    if(index<0){
        const card=drawFromDeck();
        if(card) opponentHand.push(card);
        index=opponentHand.findIndex(canPlay);
    }

    if(index>=0){
        topCard=opponentHand.splice(index,1)[0];
    }

    if(opponentHand.length===0){
        endGame(false);
        return;
    }

    playerTurn=true;
    document.getElementById("message").textContent="Your turn — choose a playable card.";
    render();
}

function callWhot(){
    if(gameOver) return;

    const index=playerHand.findIndex(c=>c.number===20);
    if(index>=0){
        playCard(index);
    }
}

function endGame(playerWon){
    gameOver=true;
    document.getElementById("resultTitle").textContent =
        playerWon ? "YOU WIN!" : "GAME OVER";
    document.getElementById("resultText").textContent =
        playerWon
        ? "You cleared your hand and won the match."
        : "The opponent cleared their hand first.";
    document.getElementById("resultModal").classList.add("show");
}

deal();
</script>
</body>
</html>
