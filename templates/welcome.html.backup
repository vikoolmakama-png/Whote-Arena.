<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#061a35">

<title>WHOT Arena</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    min-height: 100%;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    color: #fff;
    background:
        radial-gradient(circle at 50% 20%, #123e72 0%, transparent 35%),
        linear-gradient(180deg, #061a35 0%, #031020 55%, #020b16 100%);
}

.page {
    min-height: 100vh;
    max-width: 700px;
    margin: auto;
    overflow: hidden;
}

/* =========================
   HEADER
   ========================= */

.header {
    height: 76px;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(79,170,255,.25);
    background: rgba(3,15,30,.75);
}

.header-name {
    color: #62b5ff;
    font-weight: 900;
    font-size: 16px;
    letter-spacing: 1.5px;
}

.header-login {
    text-decoration: none;
    color: #fff;
    border: 1.5px solid #4faaff;
    padding: 11px 23px;
    border-radius: 28px;
    font-size: 12px;
    font-weight: 900;
}

/* =========================
   HERO
   ========================= */

.hero {
    min-height: calc(100vh - 76px);
    padding: 38px 20px 35px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* =========================
   WHOT ARENA LOGO
   ========================= */

.logo {
    width: 225px;
    height: 225px;
    position: relative;
    margin-bottom: 12px;
}

.logo-glow {
    position: absolute;
    width: 190px;
    height: 190px;
    left: 18px;
    top: 22px;
    border-radius: 50%;
    background: #168cff;
    filter: blur(55px);
    opacity: .25;
}

/* Crown */

.crown {
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    font-size: 38px;
    color: #ffd34d;
    text-shadow: 0 0 15px rgba(255,211,77,.5);
}

/* Cards */

.cards {
    position: absolute;
    width: 150px;
    height: 95px;
    top: 39px;
    left: 50%;
    transform: translateX(-50%);
}

.card {
    position: absolute;
    width: 58px;
    height: 82px;
    border-radius: 8px;
    background: linear-gradient(145deg,#ffffff,#dce8f5);
    border: 2px solid #8ecaff;
    box-shadow: 0 8px 20px rgba(0,0,0,.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 29px;
    font-weight: 900;
}

.card.left {
    left: 8px;
    transform: rotate(-17deg);
    color: #e52d49;
}

.card.middle {
    left: 46px;
    top: -5px;
    z-index: 3;
    transform: rotate(0deg);
    color: #07172c;
}

.card.right {
    right: 8px;
    transform: rotate(17deg);
    color: #1879d1;
}

/* Main shield */

.shield {
    position: absolute;
    top: 102px;
    left: 50%;
    transform: translateX(-50%);
    width: 172px;
    height: 78px;
    z-index: 4;
    background: linear-gradient(
        180deg,
        #f7d866 0%,
        #d79c20 48%,
        #9b6508 100%
    );
    clip-path: polygon(
        4% 10%,
        50% 0,
        96% 10%,
        88% 76%,
        50% 100%,
        12% 76%
    );
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #06152a;
}

.shield strong {
    font-size: 30px;
    line-height: 29px;
    font-weight: 1000;
    letter-spacing: 2px;
}

.shield span {
    font-size: 10px;
    letter-spacing: 5px;
    font-weight: 1000;
}

/* Ribbon */

.ribbon {
    position: absolute;
    z-index: 5;
    top: 166px;
    left: 50%;
    transform: translateX(-50%);
    width: 181px;
    height: 32px;
    border-radius: 4px;
    background: linear-gradient(
        90deg,
        #08335e,
        #126bc0,
        #08335e
    );
    border: 2px solid #ffd34d;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 8px;
    letter-spacing: 2.5px;
    font-weight: 900;
}

/* =========================
   TEXT
   ========================= */

.welcome-label {
    color: #62b5ff;
    font-size: 10px;
    letter-spacing: 4px;
    font-weight: 900;
    margin-top: 8px;
}

h1 {
    margin: 13px 0 0;
    font-size: 43px;
    line-height: 1;
    letter-spacing: -1.5px;
}

h1 span {
    color: #4faaff;
}

.description {
    max-width: 390px;
    color: #a9bbd0;
    font-size: 14px;
    line-height: 1.6;
    margin: 17px auto 20px;
}

.motto {
    font-size: 11px;
    letter-spacing: 4px;
    font-weight: 900;
    margin-bottom: 27px;
}

.motto span {
    color: #4faaff;
}

/* =========================
   BUTTONS
   ========================= */

.buttons {
    width: 100%;
    max-width: 390px;
    display: grid;
    gap: 12px;
}

.button {
    min-height: 57px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 1000;
}

.create {
    color: #fff;
    background: linear-gradient(
        135deg,
        #258ee8,
        #0759a8
    );
    border: 1px solid #67bdff;
    box-shadow:
        0 10px 35px rgba(20,120,220,.25);
}

.login {
    color: #fff;
    background: rgba(8,35,65,.55);
    border: 1px solid #4faaff;
}

.footer-note {
    margin-top: 27px;
    color: #60758c;
    font-size: 9px;
}

/* =========================
   DESKTOP
   ========================= */


        /* ==============================
           INSIDE THE ARENA
           ============================== */

        .arena-highlights {
            width: 100%;
            max-width: 390px;
            margin-top: 32px;
        }

        .highlights-title {
            color: #62b5ff;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 3px;
            margin-bottom: 14px;
        }

        .highlight-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .highlight-card {
            min-height: 125px;
            padding: 13px 8px;
            border-radius: 15px;
            border: 1px solid rgba(79,170,255,.25);
            background: linear-gradient(
                180deg,
                rgba(11,45,80,.72),
                rgba(5,22,40,.72)
            );
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .highlight-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            margin-bottom: 9px;
            color: #ffd34d;
            background: rgba(79,170,255,.12);
            border: 1px solid rgba(79,170,255,.3);
            font-size: 18px;
        }

        .highlight-card strong {
            color: #fff;
            font-size: 9px;
            letter-spacing: .5px;
        }

        .highlight-card span {
            color: #8298af;
            font-size: 8px;
            line-height: 1.4;
            margin-top: 6px;
        }


        @media (min-width: 700px) {

    .hero {
        padding-top: 45px;
    }

    .logo {
        transform: scale(1.15);
        margin-bottom: 25px;
    }

    h1 {
        font-size: 52px;
    }

    .description {
        font-size: 16px;
    }
}

/* =========================
   SMALL PHONES
   ========================= */

@media (max-width: 360px) {

    .hero {
        padding-top: 25px;
    }

    .logo {
        transform: scale(.82);
        margin-top: -15px;
        margin-bottom: -10px;
    }

    h1 {
        font-size: 36px;
    }

    .description {
        font-size: 13px;
    }

    .button {
        min-height: 53px;
    }
}
</style>

<style>
/* Compact Arena highlights to give the account buttons more room */
.arena-highlights {
    margin-top: 22px !important;
    margin-bottom: 10px !important;
}

.arena-highlights .highlights-title {
    margin-bottom: 12px !important;
}

.arena-highlights .highlight-grid {
    gap: 10px !important;
}

.arena-highlights .highlight-card {
    padding: 14px 8px !important;
    min-height: 150px !important;
}

.arena-highlights .highlight-icon {
    width: 52px !important;
    height: 52px !important;
    margin-bottom: 8px !important;
}

.arena-highlights .highlight-card strong {
    margin-bottom: 5px !important;
}

.arena-highlights .highlight-card span {
    line-height: 1.3 !important;
}

.buttons {
    margin-top: 12px !important;
}
</style>


<style>
.arena-benefits {
    width: 100%;
    margin: 22px auto 18px;
}

.benefits-title {
    text-align: center;
    color: #63b0ff;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 9px;
    width: 100%;
}

.benefit-item {
    min-width: 0;
    padding: 14px 7px;
    text-align: center;
    border: 1px solid #204e77;
    border-radius: 15px;
    background: linear-gradient(145deg, #0b2948, #061b31);
}

.benefit-value {
    color: #f5c94b;
    font-size: 20px;
    font-weight: 900;
    margin-bottom: 6px;
}

.benefit-label {
    color: #eef6ff;
    font-size: 10px;
    font-weight: 900;
    line-height: 1.25;
}

.benefit-note {
    color: #7f99b1;
    font-size: 9px;
    line-height: 1.3;
    margin-top: 5px;
}

@media (max-width: 390px) {
    .benefits-grid {
        gap: 6px;
    }

    .benefit-item {
        padding: 12px 5px;
    }

    .benefit-value {
        font-size: 18px;
    }

    .benefit-label {
        font-size: 9px;
    }
}
</style>

</head>

<body>

<div class="page">

    <!-- =========================
         WHOT ARENA HEADER
         ========================= -->

    <header class="header">

        <div class="header-name">
            WHOT ARENA
        </div>

        <a href="/login" class="header-login">
            LOGIN
        </a>

    </header>


    <!-- =========================
         WELCOME
         ========================= -->

    <main class="hero">

        <!-- Embedded WHOT Arena Logo -->
        <div class="logo">

            <div class="logo-glow"></div>

            <div class="crown">♛</div>

            <div class="cards">

                <div class="card left">♥</div>

                <div class="card middle">W</div>

                <div class="card right">♠</div>

            </div>

            <div class="shield">
                <strong>WHOT</strong>
                <span>ARENA</span>
            </div>

            


<div class="ribbon">
                PLAY • COMPETE • WIN
            </div>



        </div>


        <div class="welcome-label">
            WELCOME TO
        </div>


        <h1>
            WHOT <span>ARENA</span>
        </h1>


        <p class="description">
            Welcome to WHOT Arena — a place to play,
            compete and enjoy the game.
        </p>


        <div class="motto">
            PLAY <span>•</span> COMPETE <span>•</span> WIN


        </div>

<section class="arena-highlights">
  <div class="highlights-title">INSIDE THE ARENA</div>
  <div class="highlight-grid">
    <div class="highlight-card">
      <div class="highlight-icon">⚡</div>
      <strong>QUICK MATCHES</strong>
      <span>Get into the game and start playing.</span>
    </div>
    <div class="highlight-card">
      <div class="highlight-icon">🏆</div>
      <strong>COMPETE</strong>
      <span>Challenge players and climb the Arena.</span>
    </div>
    <div class="highlight-card">
      <div class="highlight-icon">₦</div>
      <strong>REWARDS</strong>
      <span>Eligible games display their prize before you play.</span>
    </div>
  </div>
</section>


<section class="arena-benefits">
    <div class="benefits-title">ARENA BENEFITS</div>

    <div class="benefits-grid">
        <div class="benefit-item">
            <div class="benefit-value">₦25</div>
            <div class="benefit-label">REFERRAL REWARD</div>
            <div class="benefit-note">For each qualifying referral</div>
        </div>

        <div class="benefit-item">
            <div class="benefit-value">₦100</div>
            <div class="benefit-label">MINIMUM DEPOSIT</div>
            <div class="benefit-note">Add funds from just ₦100</div>
        </div>

        <div class="benefit-item">
            <div class="benefit-value">₦200</div>
            <div class="benefit-label">MINIMUM WITHDRAWAL</div>
            <div class="benefit-note">Cash out from ₦200</div>
        </div>
    </div>
</section>




        <!-- Account buttons -->

        <div class="buttons">

            <a href="/register" class="button create">
                CREATE ACCOUNT
            </a>

            <a href="/login" class="button login">
                LOGIN TO YOUR ACCOUNT
            </a>

        </div>



        


        <!-- ==============================
             INSIDE THE ARENA
             ============================== -->

        

        <div class="footer-note">
            Welcome to the Arena
        </div>

    </main>

</div>

</body>
</html>
