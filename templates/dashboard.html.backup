    </div>

    <a href="/whatsapp" class="whatsapp-group">
        <span class="whatsapp-icon">◉</span>
        <span>
            <strong>JOIN OUR WHATSAPP GROUP</strong>
            <small>Join the WHOT Arena community</small>
        </span>
        <span class="whatsapp-arrow">→</span>
    </a>

</section>


<div class="grid">

<!-- PLAY -->
<section class="panel">

<div class="panel-title">
