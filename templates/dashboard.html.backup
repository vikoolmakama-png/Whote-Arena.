<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>WHOT Arena — Dashboard</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    min-height:100vh;
    color:#e4e7ff;
    background:
      radial-gradient(circle at 15% 5%,rgba(125,45,255,.20),transparent 28%),
      radial-gradient(circle at 90% 30%,rgba(0,210,255,.12),transparent 25%),
      linear-gradient(180deg,#03091d,#061433 55%,#03091d);
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

.app{
    width:min(1120px,calc(100% - 24px));
    margin:auto;
}

/* HEADER */
.header{
    height:68px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid rgba(86,92,190,.28);
}

.brand{
    display:flex;
    align-items:center;
    gap:9px;
    font-weight:1000;
    letter-spacing:1px;
}

.logo{
    width:38px;
    height:42px;
    display:grid;
    place-items:center;
    background:linear-gradient(145deg,#ffd33f,#ef9616);
    clip-path:polygon(50% 0,100% 17%,88% 78%,50% 100%,12% 78%,0 17%);
}

.logo span{
    width:29px;
    height:31px;
    display:grid;
    place-items:center;
    background:#07183c;
    clip-path:polygon(50% 0,100% 17%,88% 78%,50% 100%,12% 78%,0 17%);
    color:#ffd13c;
    font-size:17px;
}

.brand span{
    color:#ffc934;
}

.header-right{
    display:flex;
    align-items:center;
    gap:9px;
}

.logout{
    padding:9px 14px;
    border:1px solid rgba(255,54,92,.5);
    border-radius:20px;
    color:#ff6480;
    font-size:11px;
    font-weight:900;
}

.logout:hover{
    background:rgba(255,30,70,.12);
}

/* WELCOME */
.welcome{
    padding:25px 0 17px;
}

.welcome small{
    color:#3bd5ff;
    font-size:10px;
    font-weight:900;
    letter-spacing:2px;
}

.welcome h1{
    margin-top:5px;
    font-size:29px;
    color:#f0f1ff;
}

.welcome h1 span{
    color:#ffc936;
}

.welcome p{
    margin-top:5px;
    color:#7f91b8;
    font-size:12px;
}

/* BALANCE */
.balance{
    padding:23px;
    border-radius:20px;
    position:relative;
    overflow:hidden;
    background:
      radial-gradient(circle at 85% 15%,rgba(255,202,52,.18),transparent 27%),
      radial-gradient(circle at 5% 90%,rgba(139,43,255,.18),transparent 32%),
      linear-gradient(125deg,#101c4b,#081432);
    border:1px solid rgba(78,173,255,.32);
    box-shadow:0 18px 45px rgba(0,0,0,.22);
}

.balance:after{
    content:"";
    position:absolute;
    width:170px;
    height:170px;
    right:-70px;
    bottom:-90px;
    border-radius:50%;
    border:35px solid rgba(0,207,255,.07);
}

.balance-label{
    color:#8da5ca;
    font-size:10px;
    letter-spacing:1px;
}

.balance-amount{
    margin:6px 0 15px;
    font-size:38px;
    font-weight:1000;
    color:#fff;
}

.balance-actions{
    display:flex;
    gap:8px;
}

.action{
    padding:10px 17px;
    border-radius:20px;
    font-size:11px;
    font-weight:900;
}

.add{
    background:linear-gradient(135deg,#09b9ff,#3159ff);
}

.cash{
    border:1px solid #a144ff;
    color:#ca8aff;
    background:rgba(126,48,255,.09);
}

/* MAIN GRID */
.grid{
    display:grid;
    grid-template-columns:1.35fr .65fr;
    gap:14px;
    margin-top:14px;
}

/* SECTION CARD */
.panel{
    border-radius:18px;
    padding:19px;
    background:rgba(7,20,49,.84);
    border:1px solid rgba(79,94,185,.30);
}

.panel-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:14px;
}

.panel-title h2{
    font-size:17px;
}

.panel-title span{
    color:#687da7;
    font-size:9px;
}

/* PLAY CARDS */
.play-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:9px;
}

.play-card{
    min-height:120px;
    padding:16px;
    border-radius:15px;
    position:relative;
    overflow:hidden;
    border:1px solid rgba(58,167,255,.28);
    background:linear-gradient(145deg,#0c2856,#081632);
}

.play-card:after{
    content:"";
    position:absolute;
    width:85px;
    height:85px;
    right:-30px;
    bottom:-30px;
    border-radius:50%;
    background:rgba(40,205,255,.10);
}

.play-card.red{
    background:linear-gradient(145deg,#3a102d,#160c2c);
    border-color:rgba(255,46,96,.38);
}

.play-card.purple{
    background:linear-gradient(145deg,#24104c,#0e1236);
    border-color:rgba(158,68,255,.38);
}

.play-card.gold{
    background:linear-gradient(145deg,#392710,#15152c);
    border-color:rgba(255,199,51,.36);
}

.play-icon{
    font-size:25px;
    margin-bottom:10px;
}

.play-card h3{
    font-size:14px;
    margin-bottom:4px;
}

.play-card p{
    color:#8194ba;
    font-size:9px;
    line-height:1.4;
}

.play-link{
    position:absolute;
    right:13px;
    top:13px;
    color:#3fd5ff;
    font-size:10px;
    font-weight:900;
}

/* QUICK STATS */
.stats{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
}

.stat{
    padding:15px 12px;
    border-radius:14px;
    background:rgba(14,29,65,.75);
    border:1px solid rgba(81,103,190,.25);
}

.stat-icon{
    font-size:19px;
}

.stat strong{
    display:block;
    margin-top:8px;
    font-size:17px;
}

.stat small{
    color:#7286ae;
    font-size:9px;
}

/* BONUS */
.bonus{
    margin-top:14px;
    padding:17px;
    border-radius:16px;
    background:linear-gradient(110deg,rgba(255,40,100,.12),rgba(139,47,255,.13));
    border:1px solid rgba(255,76,133,.28);
}

.bonus-top{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.bonus h3{
    font-size:14px;
}

.bonus-value{
    color:#ffc936;
    font-size:21px;
    font-weight:1000;
}

.bonus p{
    margin-top:6px;
    color:#8192b5;
    font-size:9px;
    line-height:1.45;
}

/* PROFILE */
.profile{
    margin-top:14px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.profile-item{
    padding:14px;
    border-radius:14px;
    background:rgba(8,21,51,.78);
    border:1px solid rgba(72,92,170,.24);
}

.profile-item label{
    display:block;
    color:#687ea8;
    font-size:9px;
    margin-bottom:5px;
}

.profile-item strong{
    font-size:12px;
    word-break:break-word;
}

/* REFERRAL */
.referral{
    margin-top:14px;
    padding:18px;
    border-radius:17px;
    background:linear-gradient(110deg,#101044,#101a42);
    border:1px solid rgba(159,76,255,.32);
}

.referral h3{
    color:#c798ff;
    font-size:15px;
}

.referral p{
    color:#7c8eb5;
    font-size:9px;
    line-height:1.45;
    margin:6px 0 12px;
}

.referral-button{
    display:block;
    text-align:center;
    padding:10px;
    border-radius:20px;
    background:linear-gradient(135deg,#763cff,#c52eff);
    font-size:10px;
    font-weight:900;
}

/* FOOTER */
.footer{
    text-align:center;
    padding:30px 0;
    color:#536789;
    font-size:9px;
}


/* WORKING REFERRAL SYSTEM */
.referral-stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:7px;
    margin:12px 0;
}

.ref-stat{
    padding:10px 5px;
    border-radius:12px;
    background:rgba(255,255,255,.045);
    border:1px solid rgba(255,255,255,.08);
    text-align:center;
}

.ref-stat strong{
    display:block;
    color:#fff;
    font-size:14px;
    font-weight:900;
}

.ref-stat span{
    display:block;
    margin-top:4px;
    color:#7184a7;
    font-size:8px;
}

.referral-link-box{
    margin-top:10px;
}

.referral-link-box label{
    display:block;
    color:#8498bd;
    font-size:8px;
    font-weight:900;
    margin-bottom:5px;
}

.referral-link-box input{
    width:100%;
    min-width:0;
    padding:10px;
    border-radius:10px;
    border:1px solid rgba(159,76,255,.3);
    background:#080d25;
    color:#bca8ff;
    font-size:9px;
    outline:none;
}

.referral-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:7px;
    margin-top:8px;
}

.referral-actions button{
    border:0;
    cursor:pointer;
    color:#fff;
    font-family:inherit;
}

.referral-button.share-ref{
    background:linear-gradient(135deg,#e52e62,#ff5c38);
}

.referral-code{
    margin-top:10px;
    text-align:center;
    color:#7789aa;
    font-size:9px;
}

.referral-code strong{
    color:#d2a7ff;
    letter-spacing:1px;
}

.referral-rules{
    display:flex;
    flex-direction:column;
    gap:4px;
    margin-top:12px;
    padding-top:10px;
    border-top:1px solid rgba(255,255,255,.07);
    color:#7386aa;
    font-size:8px;
    line-height:1.45;
}

.referral-rules strong{
    color:#c798ff;
    font-size:9px;
    margin-bottom:2px;
}

@media(max-width:420px){
    .referral-stats{
        gap:5px;
    }

    .ref-stat{
        padding:9px 3px;
    }

    .ref-stat strong{
        font-size:12px;
    }

    .referral-actions{
        grid-template-columns:1fr;
    }
}

/* MOBILE */
@media(max-width:760px){

    .app{
        width:calc(100% - 18px);
    }

    .header{
        height:60px;
    }

    .logo{
        width:33px;
        height:36px;
    }

    .logo span{
        width:25px;
        height:27px;
        font-size:15px;
    }

    .brand{
        font-size:13px;
    }

    .welcome{
        padding:20px 0 13px;
    }

    .welcome h1{
        font-size:24px;
    }

    .balance{
        padding:19px;
        border-radius:17px;
    }

    .balance-amount{
        font-size:32px;
    }

    .grid{
        grid-template-columns:1fr;
    }

    .play-card{
        min-height:115px;
    }

    .panel{
        padding:16px;
    }
}

@media(max-width:390px){

    .play-grid{
        gap:6px;
    }

    .play-card{
        padding:13px;
    }

    .play-card h3{
        font-size:12px;
    }

    .play-card p{
        font-size:8px;
    }

    .balance-actions .action{
        padding:9px 13px;
    }
}

/* ===== STAKE SELECTOR ===== */

.stake-modal{
    position:fixed;
    inset:0;
    z-index:100;
    display:none;
    align-items:center;
    justify-content:center;
    padding:15px;
    background:rgba(1,5,18,.82);
    backdrop-filter:blur(10px);
}

.stake-modal.show{
    display:flex;
}

.stake-box{
    width:min(450px,100%);
    max-height:90vh;
    overflow:auto;
    padding:24px;
    border-radius:22px;
    background:
      radial-gradient(circle at 90% 0%,rgba(151,50,255,.18),transparent 30%),
      linear-gradient(145deg,#101a45,#050d27);
    border:1px solid rgba(80,190,255,.35);
    box-shadow:0 25px 70px rgba(0,0,0,.55);
    position:relative;
}

.stake-close{
    position:absolute;
    top:12px;
    right:14px;
    width:32px;
    height:32px;
    border:0;
    border-radius:50%;
    background:rgba(255,255,255,.06);
    color:#aab8d8;
    font-size:23px;
    cursor:pointer;
}

.stake-kicker{
    color:#38d8ff;
    font-size:9px;
    letter-spacing:3px;
    font-weight:900;
    margin-bottom:7px;
}

.stake-box h2{
    color:#eef0ff;
    font-size:24px;
}

.stake-box > p{
    color:#788caf;
    font-size:11px;
    margin-top:5px;
    margin-bottom:17px;
}

.stakes{
    display:grid;
    gap:8px;
}

.stake{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:13px 15px;
    border-radius:13px;
    background:linear-gradient(100deg,#0d2451,#10143d);
    border:1px solid rgba(75,145,220,.24);
    transition:.18s;
}

.stake:hover{
    transform:translateY(-2px);
    border-color:#36d5ff;
    background:linear-gradient(100deg,#123269,#17154b);
}

.stake strong{
    display:block;
    color:#f1f2ff;
    font-size:17px;
}

.stake small{
    display:block;
    color:#687fa8;
    font-size:8px;
    margin-top:3px;
}

.stake > span{
    color:#ffc936;
    font-size:18px;
    font-weight:1000;
}

.stake-note{
    margin-top:13px;
    padding:10px;
    border-radius:10px;
    background:rgba(0,190,255,.06);
    color:#7087ad;
    font-size:9px;
    text-align:center;
}

@media(max-width:500px){
    .stake-box{
        padding:20px 15px;
        border-radius:19px;
    }

    .stake-box h2{
        font-size:21px;
    }

    .stake{
        padding:11px 13px;
    }
}

    .whatsapp-group {
        width: 100%;
        margin-top: 14px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: #fff;
        border: 1px solid rgba(37, 211, 102, .65);
        border-radius: 16px;
        background: linear-gradient(135deg, #075e54, #128c7e);
        box-shadow: 0 8px 22px rgba(0, 0, 0, .22);
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .whatsapp-group:active {
        transform: scale(.98);
    }

    .whatsapp-icon {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #25d366;
        color: #fff;
        font-size: 24px;
        font-weight: 900;
    }

    .whatsapp-group strong {
        display: block;
        font-size: 13px;
        letter-spacing: .4px;
    }

    .whatsapp-group small {
        display: block;
        margin-top: 4px;
        color: rgba(255,255,255,.78);
        font-size: 11px;
    }

    .whatsapp-arrow {
        margin-left: auto;
        font-size: 22px;
        font-weight: 900;
    }

</style>

<style>
.stake-option {
  display:flex !important;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}
.play-now {
  background:linear-gradient(135deg,#00e676,#00bfa5);
  color:#06111f;
  padding:9px 13px;
  border-radius:10px;
  font-size:11px;
  font-weight:900;
  white-space:nowrap;
  box-shadow:0 5px 15px rgba(0,230,118,.22);
}
</style>

<style>
.stake-option{
display:flex!important;
align-items:center!important;
justify-content:space-between!important;
width:100%!important;
box-sizing:border-box!important;
}
.play-now{
display:inline-block!important;
background:linear-gradient(135deg,#00e676,#00bfa5)!important;
color:#06111f!important;
padding:10px 14px!important;
border-radius:10px!important;
font-size:11px!important;
font-weight:900!important;
white-space:nowrap!important;
}
</style>

<style>
.stake-option{
    position:relative !important;
    display:flex !important;
    align-items:center !important;
    justify-content:space-between !important;
    padding-right:18px !important;
}
.play-now{
    display:inline-flex !important;
    align-items:center !important;
    justify-content:center !important;
    background:linear-gradient(135deg,#00e676,#00bfa5) !important;
    color:#06111f !important;
    padding:10px 12px !important;
    min-width:78px !important;
    border-radius:9px !important;
    font-size:10px !important;
    font-weight:900 !important;
    letter-spacing:.4px !important;
    white-space:nowrap !important;
    box-shadow:0 4px 12px rgba(0,230,118,.25) !important;
}
@media(max-width:480px){
    .play-now{
        min-width:72px !important;
        padding:9px 8px !important;
        font-size:9px !important;
    }
}
</style>

<style>
.stakes .stake{
    display:flex !important;
    align-items:center !important;
    gap:10px !important;
}
.stakes .stake > div{
    flex:1 !important;
}
.stakes .stake > span{
    margin-left:auto !important;
}
.play-now{
    border:0 !important;
    background:linear-gradient(135deg,#00e676,#00bfa5) !important;
    color:#06111f !important;
    padding:10px 12px !important;
    border-radius:9px !important;
    font-size:10px !important;
    font-weight:900 !important;
    white-space:nowrap !important;
    cursor:pointer !important;
}
</style>

<style>
.withdraw-modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.78);
    backdrop-filter:blur(8px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:99999;
    padding:20px;
}
.withdraw-modal.show{display:flex}
.withdraw-box{
    width:100%;
    max-width:430px;
    background:linear-gradient(145deg,#101b42,#17104a);
    border:1px solid #3156a8;
    border-radius:24px;
    padding:24px;
    box-shadow:0 20px 60px rgba(0,0,0,.55);
}
.withdraw-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}
.withdraw-head h2{
    margin:0;
    color:#fff;
    font-size:24px;
}
.withdraw-close{
    border:0;
    background:#26345f;
    color:#fff;
    width:40px;
    height:40px;
    border-radius:50%;
    font-size:24px;
    cursor:pointer;
}
.withdraw-field{
    margin-bottom:15px;
}
.withdraw-field label{
    display:block;
    color:#aebbd8;
    font-size:13px;
    font-weight:700;
    margin-bottom:7px;
}
.withdraw-field input,
.withdraw-field select{
    width:100%;
    box-sizing:border-box;
    padding:14px;
    border-radius:12px;
    border:1px solid #304b86;
    background:#0b1535;
    color:#fff;
    font-size:15px;
    outline:none;
}
.withdraw-field input:focus,
.withdraw-field select:focus{
    border-color:#00d9ff;
}
.withdraw-submit{
    width:100%;
    border:0;
    padding:15px;
    border-radius:13px;
    background:linear-gradient(135deg,#ff3158,#ff8a00);
    color:#fff;
    font-weight:900;
    font-size:15px;
    cursor:pointer;
    margin-top:5px;
}
.withdraw-note{
    text-align:center;
    color:#8392b5;
    font-size:12px;
    margin-top:13px;
}
</style>

<style>
.addfund-modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.8);
    backdrop-filter:blur(8px);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:99999;
    padding:18px;
}
.addfund-modal.show{display:flex}
.addfund-box{
    width:100%;
    max-width:430px;
    max-height:92vh;
    overflow:auto;
    background:linear-gradient(145deg,#101b42,#17104a);
    border:1px solid #3156a8;
    border-radius:22px;
    padding:22px;
    box-sizing:border-box;
}
.addfund-head{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
}
.addfund-head h2{margin:0;color:#fff}
.addfund-close{
    border:0;
    background:#26345f;
    color:#fff;
    width:38px;
    height:38px;
    border-radius:50%;
    font-size:23px;
}
.addfund-info{
    background:#0b1535;
    border:1px solid #304b86;
    border-radius:14px;
    padding:14px;
    margin-bottom:16px;
    color:#fff;
}
.addfund-info strong{
    display:block;
    color:#00e676;
    font-size:20px;
    margin-top:4px;
}
.addfund-field{margin-bottom:14px}
.addfund-field label{
    display:block;
    color:#aebbd8;
    font-size:13px;
    font-weight:700;
    margin-bottom:7px;
}
.addfund-field input{
    width:100%;
    box-sizing:border-box;
    padding:13px;
    border-radius:11px;
    border:1px solid #304b86;
    background:#0b1535;
    color:#fff;
    font-size:15px;
}
.addfund-submit{
    width:100%;
    border:0;
    padding:14px;
    border-radius:12px;
    background:linear-gradient(135deg,#00e676,#00bfa5);
    color:#06111f;
    font-weight:900;
    font-size:14px;
}
</style>
<style>
.payment-method{
    text-align:center !important;
    padding:18px !important;
    background:linear-gradient(135deg,#102653,#21134f)!important;
    border:1px solid #3c65b5!important;
}
.payment-label{
    font-size:11px;
    font-weight:900;
    letter-spacing:1.5px;
    color:#8fa8d8;
    margin-bottom:6px;
}
.payment-brand{
    font-size:23px;
    font-weight:900;
    color:#fff;
}
.payment-name{
    font-size:14px;
    font-weight:800;
    color:#00e6a8;
    margin-top:4px;
}
.payment-number{
    display:inline-block;
    margin-top:9px;
    padding:9px 15px;
    border-radius:10px;
    background:#08132f;
    color:#fff;
    font-size:18px;
    font-weight:900;
    letter-spacing:1px;
}
.payment-copy{
    margin-top:9px;
    font-size:11px;
    color:#9baad0;
}
</style></head>

<body>

<div class="app">

