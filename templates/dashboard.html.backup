</section>



<!-- STAKE SELECTOR -->
<div id="stakeModal" class="stake-modal">
    <div class="stake-box">

        <button class="stake-close" onclick="closeStakes()">×</button>

        <div class="stake-kicker">NORMAL GAMES</div>
        <h2>Choose Your Stake</h2>
        <p>Select the amount you want to play with.</p>

        <div class="stakes">

            <a href="#" class="stake">
                <div>
                    <strong>₦30</strong>
                    <small>Entry stake</small>
                </div>
                <span>₦50</span><button type="button" class="play-now" onclick="playStake(30,event)">PLAY NOW</button>
            </a>

            <a href="#" class="stake">
                <div>
                    <strong>₦50</strong>
                    <small>Entry stake</small>
                </div>
                <span>₦85</span><button type="button" class="play-now" onclick="playStake(50,event)">PLAY NOW</button>
            </a>

            <a href="#" class="stake">
                <div>
                    <strong>₦100</strong>
                    <small>Entry stake</small>
                </div>
                <span>₦180</span><button type="button" class="play-now" onclick="playStake(100,event)">PLAY NOW</button>
            </a>

            <a href="#" class="stake">
                <div>
                    <strong>₦200</strong>
                    <small>Entry stake</small>
                </div>
                <span>₦350</span><button type="button" class="play-now" onclick="playStake(200,event)">PLAY NOW</button>
            </a>

            <a href="#" class="stake">
                <div>
                    <strong>₦500</strong>
                    <small>Entry stake</small>
                </div>
                <span>₦850</span><button type="button" class="play-now" onclick="playStake(500,event)">PLAY NOW</button>
            </a>

            <a href="#" class="stake">
                <div>
                    <strong>₦1,000</strong>
                    <small>Entry stake</small>
                </div>
                <span>₦1,850</span><button type="button" class="play-now" onclick="playStake(1000,event)">PLAY NOW</button>
            </a>

        </div>

        <div class="stake-note">
            🛡️ Your selected stake is held safely while matchmaking.
        </div>

    </div>
</div>

<script>
function openStakes(){
    document.getElementById("stakeModal").classList.add("show");
}

function closeStakes(){
    document.getElementById("stakeModal").classList.remove("show");
}

document.getElementById("stakeModal").addEventListener("click", function(e){
    if(e.target === this) closeStakes();
});
</script>

<footer class="footer">
    WHOT ARENA • PLAY • COMPETE • WIN<br>
    <span style="display:block;margin-top:6px">© 2026 WHOT Arena</span>
</footer>

</div>


<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".stake-option").forEach(function(row) {
        if (row.querySelector(".play-now")) return;

        var stakeText = "";
        var strong = row.querySelector("strong");

        if (strong) {
            stakeText = strong.textContent.replace(/[₦,\s]/g, "");
        }

        if (!stakeText) {
            var text = row.textContent.match(/₦\s*[\d,]+/);
            if (text) stakeText = text[0].replace(/[₦,\s,]/g, "");
        }

        var btn = document.createElement("span");
        btn.className = "play-now";
        btn.textContent = "PLAY NOW";

        btn.addEventListener("click", function(e) {
            e.preventDefault();
            e.stopPropagation();

            if (stakeText) {
                window.location.href = "/normal-game?stake=" + stakeText;
            }
        });

        row.appendChild(btn);
    });
});
</script>

<script>
function playStake(stake, event) {
    event.preventDefault();
    event.stopPropagation();
    window.location.href = "/normal-game?stake=" + stake;
}
</script>

<div class="withdraw-modal" id="withdrawModal">
    <div class="withdraw-box">
        <div class="withdraw-head">
            <h2>Cash Out</h2>
            <button class="withdraw-close" type="button" onclick="closeWithdraw()">×</button>
        </div>

        <form onsubmit="submitWithdraw(event)">
            <div class="withdraw-field">
                <label>Bank Name</label>
                <input type="text" id="withdrawBank" placeholder="Enter bank name" required>
            </div>

            <div class="withdraw-field">
                <label>Account Name</label>
                <input type="text" id="withdrawName"
                       placeholder="Enter account name" required>
            </div>

            <div class="withdraw-field">
                <label>Account Number</label>
                <input type="text" id="withdrawAccount" inputmode="numeric"
                       maxlength="10" placeholder="Enter 10-digit account number" required>
            </div>

            <div class="withdraw-field">
                <label>Amount</label>
                <input type="number" id="withdrawAmount"
                       min="200" step="1" placeholder="Minimum ₦200" required>
            </div>

            <button class="withdraw-submit" type="submit">
                SUBMIT WITHDRAWAL
            </button>

            <div class="withdraw-note">
                Minimum cash out: ₦200 • Withdrawal will be processed securely.
            </div>
        </form>
    </div>
</div>

<script>
function openWithdraw(){
    document.getElementById("withdrawModal").classList.add("show");
}

function closeWithdraw(){
    document.getElementById("withdrawModal").classList.remove("show");
}

async function submitWithdraw(e){
    e.preventDefault();

    const bank = document.getElementById("withdrawBank").value.trim();
    const name = document.getElementById("withdrawName").value.trim();
    const account = document.getElementById("withdrawAccount").value.trim();
    const amount = Number(document.getElementById("withdrawAmount").value);

    if(!bank){
        alert("Please enter your bank name.");
        return;
    }

    if(!name){
        alert("Please enter the account name.");
        return;
    }

    if(account.length !== 10 || !/^\d{10}$/.test(account)){
        alert("Please enter a valid 10-digit account number.");
        return;
    }

    if(amount < 200){
        alert("Minimum withdrawal is ₦200.");
        return;
    }

    const formData = new FormData();
    formData.append("bank_name", bank);
    formData.append("account_name", name);
    formData.append("account_number", account);
    formData.append("amount", amount);

    try{
        const response = await fetch("/withdraw", {
            method: "POST",
            body: formData
        });

        const result = await response.json();

        if(!response.ok || !result.success){
            alert(result.message || "Withdrawal submission failed.");
            return;
        }

        alert("Withdrawal submitted successfully. Admin will review your request.");
        closeWithdraw();
        location.reload();

    }catch(error){
        alert("Unable to submit withdrawal. Please try again.");
    }
}

document.addEventListener("click", function(e){
    let el = e.target.closest("a");

    if(!el) return;

    const text = el.textContent.trim().toUpperCase();

    if(text.includes("CASH OUT")){
        e.preventDefault();
        e.stopPropagation();
        openWithdraw();
    }
});

document.getElementById("withdrawModal")?.addEventListener("click", function(e){
    if(e.target === this) closeWithdraw();
});
</script>

<div class="addfund-modal" id="addFundModal">
  <div class="addfund-box">
    <div class="addfund-head">
      <h2>Add Funds</h2>
      <button type="button" class="addfund-close" onclick="closeAddFunds()">×</button>
    </div>

    <div class="addfund-info payment-method">
      <div class="payment-label">PAYMENT METHOD</div>
      <div class="payment-brand">PalmPay</div>
      <div class="payment-name">V.M.E</div>
      <div class="payment-number">8131602092</div>
      <div class="payment-copy">Send your payment to this PalmPay account</div>
    </div>

    <form onsubmit="submitAddFunds(event)">
      <div class="addfund-field">
        <label>Amount</label>
        <input type="number" id="depositAmount" min="100" step="1"
               placeholder="Minimum ₦100" required>
      </div>

      <div class="addfund-field">
        <label>Name of Sender</label>
        <input type="text" id="senderName"
               placeholder="Enter sender name" required>
      </div>

      <div class="addfund-field">
        <label>Payment Screenshot</label>
        <input type="file" id="paymentScreenshot"
               accept="image/*" required>
      </div>

      <button type="submit" class="addfund-submit">
        SUBMIT PAYMENT
      </button>
    </form>
  </div>
</div>

<script>
function openAddFunds(){
    document.getElementById("addFundModal").classList.add("show");
}
function closeAddFunds(){
    document.getElementById("addFundModal").classList.remove("show");
}
async function submitAddFunds(e){
    e.preventDefault();

    const amount = Number(document.getElementById("depositAmount").value);
    const sender = document.getElementById("senderName").value.trim();
    const screenshot = document.getElementById("paymentScreenshot").files[0];

    if(amount < 100){
        alert("Minimum deposit is ₦100.");
        return;
    }

    if(!sender || !screenshot){
        alert("Please enter the sender name and upload the payment screenshot.");
        return;
    }

    const formData = new FormData();
    formData.append("amount", amount);
    formData.append("sender_name", sender);
    formData.append("screenshot", screenshot);

    try{
        const response = await fetch("/deposit", {
            method: "POST",
            body: formData
        });

        const result = await response.json();

        if(!response.ok || !result.success){
            alert(result.message || "Deposit submission failed.");
            return;
        }

        alert("Payment submitted successfully. Admin will verify your deposit.");
        closeAddFunds();

    }catch(error){
        alert("Unable to submit payment. Please try again.");
    }
}
</script>

<script>
function getReferralLink(){
    const input = document.getElementById("myReferralLink");
    return input ? input.value : "";
}

async function copyReferralLink(){
    const link = getReferralLink();

    if(!link){
        alert("Referral link is not available.");
        return;
    }

    try{
        await navigator.clipboard.writeText(link);
        alert("Referral link copied!");
    }catch(error){
        const input = document.getElementById("myReferralLink");
        input.focus();
        input.select();
        document.execCommand("copy");
        alert("Referral link copied!");
    }
}

async function shareReferralLink(){
    const link = getReferralLink();

    if(!link){
        alert("Referral link is not available.");
        return;
    }

    const text =
        "Join me on WHOT Arena — Play • Compete • Win!\n\n" +
        "Create your account using my referral link:\n" +
        link;

    if(navigator.share){
        try{
            await navigator.share({
                title: "Join WHOT Arena",
                text: text,
                url: link
            });
        }catch(error){
            if(error.name !== "AbortError"){
                await copyReferralLink();
            }
        }
    }else{
        await copyReferralLink();
    }
}
</script>

</body>
</html>
