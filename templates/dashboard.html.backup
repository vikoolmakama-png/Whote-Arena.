    <div class="play-icon">⚡</div>
    <h3>Normal Games</h3>
    <p>Find a player and enter a head-to-head WHOT match.</p>
</a>

<a href="#" class="play-card red">
    <span class="play-link">CHALLENGE →</span>
    <div class="play-icon">⚔️</div>
    <h3>Challenge Players</h3>
    <p>Challenge another player to a battle.</p>
</a>

<a href="/tournament" class="play-card purple">
    <span class="play-link">VIEW →</span>
    <div class="play-icon">🏆</div>
    <h3>Tournaments</h3>
    <p>Join scheduled Arena competitions.</p>
</a>

<a href="#" class="play-card gold">
    <span class="play-link">VIEW →</span>
    <div class="play-icon">👑</div>
    <h3>Champion Board</h3>
    <p>See notable Arena players and achievements.</p>
</a>

</div>

</section>


<!-- STATS -->
<section class="panel">

<div class="panel-title">
    <h2>📊 My Arena</h2>
    <span>OVERVIEW</span>
</div>

<div class="stats">

<div class="stat">
    <div class="stat-icon">💳</div>
    <strong>₦0</strong>
    <small>Deposit History</small>
</div>

<div class="stat">
    <div class="stat-icon">🏦</div>
    <strong>₦0</strong>
    <small>Withdrawal History</small>
</div>

<div class="stat">
    <div class="stat-icon">🎟️</div>
    <strong>₦0</strong>
    <small>Entry Fees</small>
</div>

<div class="stat">
    <div class="stat-icon">❌</div>
    <strong>₦0</strong>
    <small>Losses</small>
</div>

<div class="stat">
    <div class="stat-icon">🏆</div>
    <strong>₦0</strong>
    <small>Wins</small>
</div>

</div>

</section>

</div>


<!-- BONUS -->
